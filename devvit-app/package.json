    "devvit": "0.15.1",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@devvit/test": "0.15.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
