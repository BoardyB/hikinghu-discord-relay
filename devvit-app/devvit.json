{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "hikinghu-relay",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "http": {
      "enable": true,
      "domains": [
        "discord.com"
      ]
    },
    "reddit": true
  },
  "triggers": {
    "onPostCreate": "/internal/triggers/post-create"
  },
  "settings": {
    "subreddit": {
      "webhookUrl": {
        "type": "string",
        "label": "Discord webhook URL",
        "helpText": "Discord channel webhook. In Discord: channel settings \u2192 Integrations \u2192 Webhooks. The channel must be a Forum channel. Leave empty to pause relaying.",
        "placeholder": "https://discord.com/api/webhooks/...",
        "validationEndpoint": "/internal/settings/webhook-url"
      }
    }
  },
  "scripts": {
    "dev": "npm run build:server -- --watch=forever",
    "build": "npm run build"
  },
  "dev": {
    "subreddit": "bbdevtest"
  }
}
